# Copy to .env and adjust. Any Postgres 15+ works (Homebrew or Docker).
DATABASE_URL="postgresql://postgres@localhost:5432/acme_salary"
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/acme_salary_test"

# 32+ random characters, e.g. `openssl rand -base64 32`. Signs session cookies.
SESSION_SECRET="change-me-to-a-long-random-string-32chars"

# The single HR Manager login created by `npm run db:seed`.
SEED_ADMIN_EMAIL="hr@acme.example"
SEED_ADMIN_PASSWORD="change-me-at-least-12-chars"
SEED_ADMIN_NAME="HR Manager"
